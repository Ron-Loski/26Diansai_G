set_global_assignment -name VERILOG_FILE ../rtl/DAC904_WriteTEST.V
set_global_assignment -name VECTOR_WAVEFORM_FILE uart.vwf
set_instance_assignment -name VIRTUAL_PIN ON -to adc_debug_clk_o
set_instance_assignment -name VIRTUAL_PIN ON -to adc_debug_sample_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_debug_status_o[*]
